# IMPORTANTE: toda variable con prefijo NEXT_PUBLIC_ viaja al navegador
# (queda visible en el bundle del cliente). Nunca pongas una API key o
# secreto real en una variable NEXT_PUBLIC_*. Si en algún momento se
# necesita una credencial para el endpoint del formulario, esa variable
# va SIN el prefijo NEXT_PUBLIC_ (solo la usa el servidor).

# Endpoint del formulario de precalificación. Sin prefijo NEXT_PUBLIC_ a
# propósito: solo lo usa app/api/lead/route.ts del lado del servidor, nunca
# el navegador (ver LeadForm.tsx). Temporal hasta que la API de score-app
# esté lista — José confirma el valor real. Mientras esté vacía, el
# formulario solo hace console.log del payload.
LEAD_FORM_API_URL=

# Analítica (Google Analytics / Plausible / lo que se decida)
NEXT_PUBLIC_ANALYTICS_ID=

# URL de producción del sitio, usada por robots.ts y sitemap.ts.
# Vacía en local (usa http://localhost:3000 por defecto) — José la define
# cuando el dominio esté configurado.
NEXT_PUBLIC_SITE_URL=
