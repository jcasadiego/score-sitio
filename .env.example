# IMPORTANTE: toda variable con prefijo NEXT_PUBLIC_ viaja al navegador
# (queda visible en el código del sitio). El sitio no usa secretos: nunca
# pongas una API key, contraseña o token en este archivo ni en el código.
#
# Las tres se leen al compilar: en Render, cambiarlas exige redesplegar.

# URL base de la API de score-app (sin barra final). El formulario envía a
# {NEXT_PUBLIC_API_URL}/api/v1/leads/prequalification. No es un secreto: el
# endpoint es público. En local: la api de score-app corriendo en :3000, o la
# de QA (https://score-api-qa.onrender.com) si José agregó tu origen local.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL pública del sitio, usada por robots.ts y sitemap.ts. Vacía en local
# (usa http://localhost:3003 por defecto).
NEXT_PUBLIC_SITE_URL=

# Analítica: el proveedor aún no está decidido (José lo aprueba antes de
# integrarlo, porque recibe datos de los visitantes).
NEXT_PUBLIC_ANALYTICS_ID=
